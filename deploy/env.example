# Настройки бота на сервере. Настоящий файл — /etc/schedule/env, доступ
# только у службы (chmod 600). В репозиторий он не попадает.

# Токен бота от @BotFather.
BOT_TOKEN=
# Telegram id владельца — ему доступны служебные команды.
OWNER_ID=
# Случайная строка: ею подписаны обезличенные счётчики открытий.
STATS_SALT=
# Случайная строка: по ней бот узнаёт, что сообщение прислал Telegram.
WEBHOOK_SECRET=
# Токен GitHub — чтобы бот мог запускать разбор присланного PDF. Необязателен.
GITHUB_TOKEN=

# Адрес приложения и где лежит база.
APP_URL=https://app.bodryash.ru/
DB_PATH=/var/lib/schedule/schedule.sqlite
PORT=8787

# 1 — не слать напоминания и рассылки. Нужно, пока бот работает в двух
# местах сразу (репетиция переноса): иначе студенты получат всё дважды.
NO_CRON=
